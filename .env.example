# Mojud local settings. Copy to .env:  cp .env.example .env
# local only - change before any deployment
# Every value below is a working local-only placeholder, not a secret (NFR1.12).

# Database container (db service)
POSTGRES_USER=mojud
# local only - change before any deployment
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=mojud

# Backend and migrate services (inside Docker Compose the database host is "db").
# `npm run dev` replaces db:5432 with localhost:5433 for the API running on the host.
DATABASE_URL=postgres://mojud:local-dev-only@db:5432/mojud

# Tests: the mojud_test database in the same db container, reached on the host port.
TEST_DATABASE_URL=postgres://mojud:local-dev-only@localhost:5433/mojud_test

# Origin check allow-list (NFR1.19): comma-separated, exact origins.
APP_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# No HTTPS on localhost; must be true once the app is deployed (NFR1.5).
COOKIE_SECURE=false

LOG_LEVEL=info
DB_POOL_MAX=10
