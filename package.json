{
  "name": "mojud",
  "version": "0.1.0",
  "private": true,
  "description": "Mojud inventory and stock management (walking skeleton).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "up": "docker compose up -d --build --wait",
    "down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "build": "tsc -b && npm run build -w @mojud/web",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test -c apps/web/playwright.config.ts",
    "verify": "node scripts/verify.mjs",
    "logs:errors": "node scripts/logs-errors.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
}
